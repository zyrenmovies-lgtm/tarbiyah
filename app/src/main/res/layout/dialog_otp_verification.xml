<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_card"
    android:padding="24dp">

    <!-- Header Gold Accent Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_gold"
        android:layout_marginBottom="16dp" />

    <!-- Icon Lock / WhatsApp -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@android:drawable/ic_lock_idle_lock"
        app:tint="@color/gold_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Verifikasi WhatsApp Siswa"
        android:textColor="@color/gold_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_otp_dest_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Kode OTP 6 digit telah dikirim ke nomor WhatsApp Anda"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp" />

    <!-- 6 Digit OTP Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_otp_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="none"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_otp_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_outline"
            android:padding="16dp"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:letterSpacing="0.4"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gold_light"
            android:hint="------"
            android:textColorHint="@color/text_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Resend Timer -->
    <TextView
        android:id="@+id/tv_resend_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Kirim ulang kode dalam 60s"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_otp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_button_outlined"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_confirm_otp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:text="Verifikasi"
            android:textColor="@color/black_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_button_gold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
