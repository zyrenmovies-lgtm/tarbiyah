<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/black_card"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <ImageView
                android:id="@+id/iv_post_avatar"
                android:layout_width="@dimen/avatar_size_sm"
                android:layout_height="@dimen/avatar_size_sm"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/bg_avatar_placeholder"
                android:padding="6dp"
                android:tint="@color/gold_primary"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_post_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@rizki_tarbiyah"
                    android:textColor="@color/gold_primary"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 menit lalu"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <!-- Follow Button -->
            <Button
                android:id="@+id/btn_follow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Ikuti"
                android:textColor="@color/gold_primary"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold"
                android:background="@drawable/bg_button_outlined"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md" />
        </LinearLayout>

        <!-- Post Content -->
        <TextView
            android:id="@+id/tv_post_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assalamualaikum! Hari ini baru ngerti soal fungsi linear, ternyata mudah kalau dipahami dari contoh nyata. Alhamdulillah!"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_md"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_like"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/btn_star_big_off"
                android:tint="@color/gold_primary"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginEnd="@dimen/spacing_md" />

            <ImageView
                android:id="@+id/btn_comment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="@color/text_secondary"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
