<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_md"
                android:background="@color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assalamualaikum,"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_md" />

                        <TextView
                            android:id="@+id/tv_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Muhammad Rizki!"
                            android:textColor="@color/gold_primary"
                            android:textSize="@dimen/text_xl"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- Avatar -->
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="@drawable/bg_avatar_placeholder"
                        android:padding="@dimen/spacing_sm"
                        android:tint="@color/gold_primary"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>

            <!-- Countdown Prayer Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_prayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:background="@drawable/bg_card_green">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_prayer"
                        android:textColor="@color/green_accent"
                        android:textSize="@dimen/text_sm"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/spacing_xs">

                        <TextView
                            android:id="@+id/tv_prayer_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dzuhur"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xl"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_prayer_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:30"
                            android:textColor="@color/gold_primary"
                            android:textSize="@dimen/text_xl"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Countdown -->
                    <TextView
                        android:id="@+id/tv_prayer_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="dalam 1 jam 23 menit"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_md"
                        android:layout_marginTop="@dimen/spacing_xs" />

                    <!-- Progress Bar Prayer -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_prayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:trackColor="@color/green_dark"
                        app:indicatorColor="@color/gold_primary"
                        app:trackCornerRadius="4dp"
                        android:progress="60" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section: Progres + Poin Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md">

                <!-- Study Progress Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_study_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:background="@drawable/bg_card_gold">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/study_progress"
                            android:textColor="@color/gold_text"
                            android:textSize="@dimen/text_xs"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_study_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75%"
                            android:textColor="@color/gold_light"
                            android:textSize="@dimen/text_xxxl"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/spacing_xs" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_study"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:trackColor="@color/gold_dark"
                            app:indicatorColor="@color/gold_light"
                            app:trackCornerRadius="4dp"
                            android:progress="75" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3/4 Modul"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pahala Points Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_pahala"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:background="@drawable/bg_premium_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pahala_points"
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/text_xs"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_pahala_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.250"
                            android:textColor="@color/gold_primary"
                            android:textSize="@dimen/text_xxxl"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/spacing_xs" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Poin"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs" />

                        <!-- Rank Chip -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_rank"
                            style="@style/Widget.TarbiyahAiLearn.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rank #12"
                            android:layout_marginTop="@dimen/spacing_sm" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Mode Kejar Target Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_catch_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_dark">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/catch_up_mode"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_catch_up_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 modul Matematika tertinggal"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_catch_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mulai"
                        android:textColor="@color/black_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_sm"
                        android:background="@drawable/bg_button_gold"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pengingat Harian Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminders"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg" />

            <!-- Reminder Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm">

                <!-- Sedekah -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reminder_sedekah"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/black_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm"
                        android:background="@drawable/bg_premium_card"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_send"
                            android:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sedekah"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="4dp" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="3dp"
                            android:background="@color/green_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sholat -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reminder_sholat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/black_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm"
                        android:background="@drawable/bg_premium_card"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:tint="@color/green_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sholat"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="4dp" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="3dp"
                            android:background="@color/gold_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Belajar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reminder_belajar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/black_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm"
                        android:background="@drawable/bg_premium_card"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:tint="@color/gold_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belajar"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="4dp" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="3dp"
                            android:background="@color/gold_primary"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pengingat -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reminder_lainnya"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="@color/black_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm"
                        android:background="@drawable/bg_premium_card"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:tint="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lainnya"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="4dp" />
                        <View
                            android:layout_width="20dp"
                            android:layout_height="3dp"
                            android:background="@color/black_divider"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Today's Schedule header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jadwal Hari Ini"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg" />

            <!-- Prayer Times Horizontal List -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_md"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_prayer_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Subuh -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subuh"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_xs" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="04:52"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Dzuhur (active) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm"
                            android:gravity="center"
                            android:background="@drawable/bg_card_gold">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dzuhur"
                                android:textColor="@color/gold_text"
                                android:textSize="@dimen/text_xs" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:30"
                                android:textColor="@color/gold_light"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ashar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ashar"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_xs" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15:45"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Maghrib -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maghrib"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_xs" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18:22"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Isya -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_sm"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Isya"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_xs" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="19:32"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
