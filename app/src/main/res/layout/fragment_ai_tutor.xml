<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:background="@color/black_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_tutor_title"
                android:textColor="@color/gold_primary"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belajar cerdas bersama AI islami"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <!-- Mulai Belajar Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_start_study"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_gold">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_study"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lanjutkan: Matematika Kelas X"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.TarbiyahAiLearn.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bab 3: Fungsi Linear"
                        android:layout_marginTop="@dimen/spacing_sm" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="@color/gold_primary"
                    android:layout_marginStart="@dimen/spacing_md" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tes Mendadak AI Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_quick_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_dark">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_report_image"
                    android:tint="@color/color_warning"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quick_test"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kamera aktif, keluar = diskualifikasi"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/gold_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Asisten Tahfidz Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_tahfidz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_green">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="@color/green_accent"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tahfidz_assistant"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Koreksi tajwid dan hafalan real-time"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/green_accent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ruang Fokus Bersama Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_focus_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/black_card"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:tint="@color/text_secondary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_room"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belajar bersama, chat dinonaktifkan"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Online"
                    app:chipBackgroundColor="@color/green_subtle"
                    app:chipStrokeColor="@color/green_primary"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/green_accent"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mode Kejar Target Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_catch_up_tutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/black_card"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="@color/gold_primary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catch_up_mode_card"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kejar ketertinggalan dengan AI"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/gold_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
